#version 330 core

in vec3 FragPos;
in vec3 Normal;
in vec2 TexCoord;

out vec4 FragColor;

uniform sampler2D texture1;
uniform vec3 materialColor;
uniform int useTexture;
uniform vec3 viewPos;
uniform int isSun;
uniform vec3 lightPos;
uniform vec3 lightColor;

void main()
{
    // Sample texture (or use material color)
    vec4 texSample = vec4(materialColor, 1.0);
    if (useTexture == 1) {
        vec2 fixedTexCoord = vec2(1.0 - TexCoord.x, 1.0 - TexCoord.y); // Flip both X and Y to correct orientation
        texSample = texture(texture1, fixedTexCoord);
    }

    vec3 baseColor = texSample.rgb;
    float alpha = texSample.a;

    vec3 color = baseColor;

    if (isSun == 1) {
        // Emissive sun with strong glow
        color *= 8.0;
        float distToCenter = distance(TexCoord, vec2(0.5));
        float glow = 1.0 - smoothstep(0.0, 0.75, distToCenter);
        color += glow * vec3(1.0, 0.75, 0.5) * 18.0;
        color += vec3(3.0, 2.2, 1.5); // bright core
    } else {
        // Standard Blinn-Phong lighting from the Sun
        vec3 norm = normalize(Normal);
        vec3 lightDir = normalize(lightPos - FragPos);

        // Diffuse
        float diff = max(dot(norm, lightDir), 0.0);
        vec3 diffuse = lightColor * diff;

        // Ambient (very low for space, but a hint higher than before so night sides lift)
        vec3 ambient = lightColor * 0.08;

        // Specular (Blinn-Phong)
        vec3 viewDir = normalize(viewPos - FragPos);
        vec3 halfwayDir = normalize(lightDir + viewDir);
        float spec = pow(max(dot(norm, halfwayDir), 0.0), 32.0);
        vec3 specular = lightColor * spec * 0.45;

        color = (ambient + diffuse + specular) * baseColor;
    }

    FragColor = vec4(color, alpha);
}